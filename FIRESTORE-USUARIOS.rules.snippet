/* Inserir dentro de:
   service cloud.firestore {
     match /databases/{database}/documents {
       ... AQUI ...
     }
   }

   Esta árvore é usada SOMENTE pelo estado pessoal da A Noite e do Modo Solo.
   Cada conta Google enxerga e altera apenas o próprio uid. */
match /usuarios/{uid}/{document=**} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}

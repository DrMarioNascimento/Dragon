rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function known(versao) {
      return versao in ['mosaico', 'noite'];
    }
    function emailMestre() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/config/mestres)
        && request.auth.token.email in get(/databases/$(database)/documents/config/mestres).data.emails;
    }
    function roomPath(versao, room) {
      return /databases/$(database)/documents/$(versao)/$(room);
    }
    function roomExists(versao, room) {
      return exists(roomPath(versao, room));
    }
    function room(versao, room) {
      return get(roomPath(versao, room)).data;
    }
    function active(versao, roomId) {
      return known(versao) && roomExists(versao, roomId) && room(versao, roomId).ativa == true;
    }
    function master(versao, roomId) {
      return known(versao) && signedIn() && roomExists(versao, roomId) && room(versao, roomId).mestreUid == request.auth.uid;
    }
    function participant(versao, roomId) {
      return known(versao) && signedIn() && exists(/databases/$(database)/documents/$(versao)/$(roomId)/jogadores/$(request.auth.uid));
    }
    function inside(versao, roomId) {
      return master(versao, roomId) || participant(versao, roomId);
    }
    function v3(versao, roomId) {
      return roomExists(versao, roomId) && room(versao, roomId).get('v3', false) == true;
    }
    /* Mesa HTML + noite v3. Qualquer outro valor de fase é recusado,
       inclusive pelo mestre — impede sala fantasma / lixo no documento. */
    function faseConhecida() {
      return request.resource.data.fase in [
        'sala', 'encenacao', 'votacao',
        'inclinacao', 'constelacao', 'janela', 'comodo', 'vidro', 'salaescura', 'cor',
        'mosaico', 'encaixe', 'cooperacao',
        'palimpsesto', 'espelho', 'planta',
        'mercado', 'oleo',
        'deducao', 'resultado'
      ];
    }
    function tarefaConhecida(nome) {
      return nome in ['constelacao', 'inclinacao', 'sala'];
    }
    /* O cliente PRECISA poder acrescentar pista ao proprio Arquivo: e assim
       que a pista privada do personagem e a pista de cada tarefa sensorial
       chegam. O que esta regra faz e encarecer o abuso, nao elimina-lo:
       o Arquivo cresce no maximo uma pista por escrita e a mesma escrita
       nao pode encostar nas moedas. Quem insistir ainda consegue repetir a
       operacao vezes seguidas — a eliminacao real exige que a concessao de
       pista saia do jogador (mestre ou Cloud Functions), conforme o
       HANDOFF secao 16.3.                                               */
    function ownPlayerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'pronto', 'personagem', 'pistas', 'fragmentoPronto',
          'fragmentoProntoMs', 'atualizadoEmMs'
        ])
        && (
          !changed.hasAny(['pistas'])
          || (
            request.resource.data.get('pistas', []).size()
              <= resource.data.get('pistas', []).size() + 1
            && request.resource.data.get('moedas', 0) == resource.data.get('moedas', 0)
          )
        );
    }
    function purchasePlayerUpdate(versao, roomId, playerId) {
      let marker = request.resource.data.ultimaNegociacao;
      let negotiation = getAfter(/databases/$(database)/documents/$(versao)/$(roomId)/negociacoes/$(marker)).data;
      let buyer = negotiation.compradorId;
      let seller = negotiation.vendedorId;
      let price = negotiation.preco;
      return marker is string
        && negotiation.status == 'comprada'
        && buyer == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moedas', 'pistas', 'ultimaNegociacao'])
        && request.resource.data.moedas is int
        && request.resource.data.moedas >= 0
        && (
          (playerId == buyer
            && request.resource.data.moedas == resource.data.moedas - price
            && request.resource.data.pistas.size() >= resource.data.get('pistas', []).size()
            && request.resource.data.pistas.size() <= resource.data.get('pistas', []).size() + 1)
          ||
          (playerId == seller
            && request.resource.data.moedas == resource.data.moedas + price
            && request.resource.data.pistas == resource.data.pistas)
        );
    }

    match /config/mestres {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{versao}/{roomId} {
      allow create: if known(versao)
        && signedIn()
        && emailMestre()
        && request.resource.data.mestreUid == request.auth.uid
        && request.resource.data.ativa == true
        && request.resource.data.fase == 'sala'
        && (!request.resource.data.keys().hasAny(['ritmo'])
          || request.resource.data.ritmo in ['automatico', 'conduzido'])
        && (!request.resource.data.keys().hasAny(['formato'])
          || request.resource.data.formato in ['curta', 'cheia'])
        && (!request.resource.data.keys().hasAny(['v3'])
          || request.resource.data.v3 == true)
        && (!request.resource.data.keys().hasAny(['lanternaCurta'])
          || request.resource.data.lanternaCurta in ['janela', 'salaescura'])
        && request.resource.data.keys().hasOnly([
          'ativa', 'fase', 'vez', 'modo', 'ritmo', 'mestreUid', 'criadaEm', 'criadaEmMs',
          'formato', 'v3', 'lanternaCurta'
        ]);
      allow get: if signedIn() && (
        !exists(roomPath(versao, roomId))
        || resource.data.ativa == true
        || master(versao, roomId)
        || participant(versao, roomId)
      );
      allow list: if false;
      allow update: if master(versao, roomId)
        && request.resource.data.mestreUid == resource.data.mestreUid
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fase'])
          || faseConhecida()
        );
      allow delete: if false;

      match /jogadores/{playerId} {
        /* A entrada consulta a lista antes de criar o próprio documento,
           para respeitar o limite e evitar personagem duplicado. */
        allow read: if signedIn() && active(versao, roomId);
        allow create: if active(versao, roomId)
          && signedIn()
          && playerId == request.auth.uid
          && request.resource.data.nome is string
          && request.resource.data.nome.size() >= 1
          && request.resource.data.nome.size() <= 60
          && request.resource.data.forma in ['m', 'f', 'n']
          && request.resource.data.moedas is int
          && request.resource.data.moedas >= 0
          && request.resource.data.keys().hasOnly([
            'nome', 'personagem', 'forma', 'pronto', 'entrouMs', 'votos',
            'moedas', 'total', 'atualizadoEmMs'
          ]);
        allow update: if active(versao, roomId) && (
          master(versao, roomId)
          || (playerId == request.auth.uid && ownPlayerUpdate())
          || purchasePlayerUpdate(versao, roomId, playerId)
        );
        allow delete: if false;
      }

      match /votos/{voteId} {
        allow read: if master(versao, roomId) || voteId == request.auth.uid;
        allow create: if active(versao, roomId)
          && voteId == request.auth.uid
          && request.resource.data.de == request.auth.uid
          && request.resource.data.para != request.auth.uid
          && exists(/databases/$(database)/documents/$(versao)/$(roomId)/jogadores/$(request.resource.data.para))
          && request.resource.data.keys().hasOnly(['de', 'para', 'ms']);
        allow update, delete: if false;
      }

      match /acoes/{actionId} {
        allow read: if master(versao, roomId) || actionId == request.auth.uid;
        allow create: if active(versao, roomId)
          && actionId == request.auth.uid
          && request.resource.data.jogadorId == request.auth.uid
          && request.resource.data.tipo == 'concluirApresentacao'
          && request.resource.data.vez is int
          && request.resource.data.keys().hasOnly(['tipo', 'jogadorId', 'vez', 'criadaEm']);
        allow update: if master(versao, roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processada', 'processadaMs']);
        allow delete: if false;
      }

      match /publicas/{publicId} {
        allow read: if inside(versao, roomId);
        allow create, update: if master(versao, roomId);
        allow delete: if false;
      }

      match /tarefas/{taskId} {
        allow read: if master(versao, roomId)
          || taskId == request.auth.uid + '_constelacao'
          || taskId == request.auth.uid + '_inclinacao'
          || taskId == request.auth.uid + '_sala';
        /* inclinacao = Janela do Norte; constelacao = Vidro Embaçado;
           sala = Sala às Escuras (v3). `tempoMs` continua fora: era
           auto-reportado e nada no placar o consumia. */
        allow create: if active(versao, roomId)
          && request.resource.data.jogadorId == request.auth.uid
          && tarefaConhecida(request.resource.data.tarefa)
          && request.resource.data.runId is string
          && request.resource.data.runId.size() > 0
          && taskId == request.auth.uid + '_' + request.resource.data.tarefa
          && request.resource.data.keys().hasOnly([
            'tarefa', 'jogadorId', 'runId', 'concluidoEm'
          ]);
        allow update: if active(versao, roomId)
          && resource.data.jogadorId == request.auth.uid
          && !resource.data.keys().hasAny(['concluidoEm'])
          && request.resource.data.jogadorId == request.auth.uid
          && request.resource.data.tarefa == resource.data.tarefa
          && tarefaConhecida(request.resource.data.tarefa)
          && request.resource.data.runId is string
          && request.resource.data.runId.size() > 0
          && taskId == request.auth.uid + '_' + request.resource.data.tarefa
          && request.resource.data.keys().hasOnly([
            'tarefa', 'jogadorId', 'runId', 'concluidoEm'
          ]);
        allow delete: if false;
      }

      match /nucleos/{nucleusId} {
        allow read: if inside(versao, roomId);
        allow create: if master(versao, roomId);
        allow update: if master(versao, roomId) || (
          active(versao, roomId)
          && participant(versao, roomId)
          && get(/databases/$(database)/documents/$(versao)/$(roomId)/jogadores/$(request.auth.uid)).data.nucleo == resource.data.numero
          && (
            resource.data.portadorId == request.auth.uid
            || resource.data.get('portadoresCompartilhados', false) == true
            || v3(versao, roomId)
          )
          && request.resource.data.portadorId == resource.data.portadorId
          && request.resource.data.get('portadoresCompartilhados', false)
            == resource.data.get('portadoresCompartilhados', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rascunho', 'rascunhoMs', 'concluidoEm'
          ])
        );
        allow delete: if false;
      }

      match /votosCooperacao/{voteId} {
        allow read: if master(versao, roomId) || voteId == request.auth.uid;
        allow create: if active(versao, roomId)
          && voteId == request.auth.uid
          && request.resource.data.de == request.auth.uid
          && request.resource.data.para != request.auth.uid
          && request.resource.data.nucleo == get(/databases/$(database)/documents/$(versao)/$(roomId)/jogadores/$(request.auth.uid)).data.nucleo
          && request.resource.data.nucleo == get(/databases/$(database)/documents/$(versao)/$(roomId)/jogadores/$(request.resource.data.para)).data.nucleo
          && request.resource.data.keys().hasOnly(['de', 'para', 'nucleo', 'ms']);
        allow update, delete: if false;
      }

      match /ofertas/{offerId} {
        allow read: if inside(versao, roomId);
        allow create: if active(versao, roomId)
          && request.resource.data.vendedorId == request.auth.uid
          && request.resource.data.status == 'aberta'
          && request.resource.data.faixaPreco in ['baixo', 'justo', 'alto']
          && request.resource.data.preco in [1, 3, 5]
          && request.resource.data.keys().hasOnly([
            'vendedorId', 'vendedorNome', 'pistaId', 'faixaPreco', 'preco', 'status', 'criadaMs'
          ]);
        allow update: if active(versao, roomId)
          && resource.data.status == 'aberta'
          && request.resource.data.status == 'comprada'
          && request.resource.data.compradorId == request.auth.uid
          && request.auth.uid != resource.data.vendedorId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'compradorId', 'compradaMs'])
          && getAfter(/databases/$(database)/documents/$(versao)/$(roomId)/negociacoes/$(offerId)).data.compradorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/$(versao)/$(roomId)/negociacoes/$(offerId)).data.vendedorId == resource.data.vendedorId
          && getAfter(/databases/$(database)/documents/$(versao)/$(roomId)/negociacoes/$(offerId)).data.preco == resource.data.preco;
        allow delete: if false;
      }

      match /negociacoes/{negotiationId} {
        allow read: if inside(versao, roomId);
        allow create: if active(versao, roomId)
          && request.resource.data.status == 'comprada'
          && request.resource.data.compradorId == request.auth.uid
          && request.resource.data.vendedorId != request.auth.uid
          && request.resource.data.preco is int
          && request.resource.data.preco > 0
          && get(/databases/$(database)/documents/$(versao)/$(roomId)/ofertas/$(negotiationId)).data.vendedorId == request.resource.data.vendedorId
          && get(/databases/$(database)/documents/$(versao)/$(roomId)/ofertas/$(negotiationId)).data.preco == request.resource.data.preco;
        allow update, delete: if false;
      }

      match /deducoes/{deductionId} {
        allow read: if master(versao, roomId) || deductionId == request.auth.uid;
        allow create: if active(versao, roomId)
          && deductionId == request.auth.uid
          && request.resource.data.id == request.auth.uid
          && request.resource.data.suspeito is string
          && request.resource.data.motivo is string
          && request.resource.data.acao is string
          && request.resource.data.prova is string
          && request.resource.data.lacuna is string
          && request.resource.data.submetidoEm is int
          && request.resource.data.keys().hasOnly([
            'id', 'suspeito', 'motivo', 'acao', 'prova', 'lacuna',
            'pistasUsadas', 'submetidoEm'
          ]);
        allow update, delete: if false;
      }

      match /{otherCollection}/{document=**} {
        allow read, write: if false;
      }
    }
  }
}

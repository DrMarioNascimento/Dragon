rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function known(v) { return v in ['mosaico', 'noite', 'carroforte', 'carroforte-noite']; }
    function validPartida(id) { return id in ['sete','cinco','apagao','nome','corpo','perceber']; }
    function roomPath(v, id) { return /databases/$(database)/documents/$(v)/$(id); }
    function roomExists(v, id) { return exists(roomPath(v,id)); }
    function room(v, id) { return get(roomPath(v,id)).data; }
    function active(v, id) { return known(v) && roomExists(v,id) && room(v,id).ativa == true; }
    function master(v, id) { return signedIn() && roomExists(v,id) && room(v,id).mestreUid == request.auth.uid; }
    function participant(v, id) { return signedIn() && exists(/databases/$(database)/documents/$(v)/$(id)/jogadores/$(request.auth.uid)); }
    function inside(v, id) { return master(v,id) || participant(v,id); }
    function emailMestre() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/config/mestres)
        && request.auth.token.email in get(/databases/$(database)/documents/config/mestres).data.emails;
    }
    function faseConhecida(f) {
      return f in ['sala','jogo','encenacao','votacao','inclinacao','constelacao','janela','comodo','vidro','salaescura','cor','mosaico','encaixe','cooperacao','palimpsesto','espelho','planta','mercado','oleo','deducao','dossie','decisao','resultado'];
    }

    match /config/mestres {
      allow read: if signedIn();
      allow write: if false;
    }

    match /usuarios/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{versao}/{roomId} {
      allow create: if known(versao)
        && emailMestre()
        && request.resource.data.mestreUid == request.auth.uid
        && request.resource.data.ativa == true
        && request.resource.data.fase == 'sala'
        && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId))
        && (!request.resource.data.keys().hasAny(['ritmo']) || request.resource.data.ritmo in ['automatico','conduzido','calma','pressao'])
        && (!request.resource.data.keys().hasAny(['formato']) || request.resource.data.formato in ['curta','cheia']);

      allow get: if signedIn() && (!roomExists(versao,roomId) || resource.data.ativa == true || inside(versao,roomId));
      allow list: if false;

      allow update: if master(versao,roomId)
        && request.resource.data.mestreUid == resource.data.mestreUid
        && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId))
        && (!request.resource.data.keys().hasAny(['fase']) || faseConhecida(request.resource.data.fase));
      allow delete: if false;

      match /jogadores/{playerId} {
        allow read: if signedIn() && active(versao,roomId);
        allow create: if signedIn() && active(versao,roomId) && playerId == request.auth.uid
          && request.resource.data.nome is string
          && request.resource.data.nome.size() >= 1
          && request.resource.data.nome.size() <= 60;
        allow update: if active(versao,roomId) && (master(versao,roomId) || playerId == request.auth.uid);
        allow delete: if false;
      }

      match /publicas/{id} {
        allow read: if inside(versao,roomId);
        allow create, update: if master(versao,roomId);
        allow delete: if false;
      }

      match /tarefas/{id} {
        allow read: if inside(versao,roomId);
        allow create, update: if active(versao,roomId) && signedIn()
          && request.resource.data.jogadorId == request.auth.uid;
        allow delete: if false;
      }

      match /nucleos/{id} {
        allow read: if inside(versao,roomId);
        allow create: if master(versao,roomId);
        allow update: if active(versao,roomId) && inside(versao,roomId);
        allow delete: if false;
      }

      match /votos/{id} {
        allow read: if master(versao,roomId) || id == request.auth.uid;
        allow create: if active(versao,roomId) && id == request.auth.uid;
        allow update, delete: if false;
      }

      match /votosCooperacao/{id} {
        allow read: if inside(versao,roomId);
        allow create: if active(versao,roomId) && signedIn() && request.resource.data.de == request.auth.uid;
        allow update, delete: if false;
      }

      match /acoes/{id} {
        allow read: if inside(versao,roomId);
        allow create: if active(versao,roomId) && signedIn() && request.resource.data.jogadorId == request.auth.uid;
        allow update: if master(versao,roomId);
        allow delete: if false;
      }

      match /ofertas/{id} {
        allow read: if inside(versao,roomId);
        allow create, update: if active(versao,roomId) && participant(versao,roomId);
        allow delete: if false;
      }

      match /negociacoes/{id} {
        allow read: if inside(versao,roomId);
        allow create: if active(versao,roomId) && participant(versao,roomId);
        allow update, delete: if false;
      }

      match /deducoes/{id} {
        allow read: if master(versao,roomId) || id == request.auth.uid;
        allow create: if active(versao,roomId)
          && id == request.auth.uid
          && request.resource.data.id == request.auth.uid
          && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId));
        allow update, delete: if false;
      }

      match /placar/{id} {
        allow read: if inside(versao,roomId);
        allow create, update: if master(versao,roomId);
        allow delete: if false;
      }

      match /{otherCollection}/{document=**} {
        allow read, write: if false;
      }
    }
  }
}

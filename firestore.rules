rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    /* Raízes canônicas: mosaico | noite (por projeto — ver FIREBASE-ISOLAMENTO.md).
       carroforte / carroforte-noite ficam como aliases legados: salas antigas
       ainda podem existir sob esses nomes; nenhum cliente atual escreve neles.
       Não remover sem auditar dados remotos. */
    function known(v) { return v in ['mosaico','noite','carroforte','carroforte-noite']; }
    /* IDs de pergunta da Casa (raiz partidaId). Carro usa partida.pergunta aninhado
       e NÃO deve gravar partidaId na raiz — se gravar, só passa se for um destes. */
    function validPartida(id) { return id in ['sete','cinco','apagao','nome','corpo','perceber']; }
    function roomPath(v,id) { return /databases/$(database)/documents/$(v)/$(id); }
    function roomExists(v,id) { return exists(roomPath(v,id)); }
    function room(v,id) { return get(roomPath(v,id)).data; }
    function active(v,id) { return known(v) && roomExists(v,id) && room(v,id).ativa == true; }
    function master(v,id) { return signedIn() && roomExists(v,id) && room(v,id).mestreUid == request.auth.uid; }
    function participant(v,id) { return signedIn() && exists(/databases/$(database)/documents/$(v)/$(id)/jogadores/$(request.auth.uid)); }
    function inside(v,id) { return master(v,id) || participant(v,id); }
    function emailMestre() { return signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/config/mestres) && request.auth.token.email in get(/databases/$(database)/documents/config/mestres).data.emails; }
    function faseConhecida(f) { return f in ['sala','jogo','encenacao','votacao','inclinacao','constelacao','janela','comodo','vidro','salaescura','cor','mosaico','encaixe','cooperacao','palimpsesto','espelho','planta','mercado','oleo','deducao','dossie','decisao','resultado']; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    /* Convidado: prontidão/personagem (Casa), papel/camada, resumo HPC A/B/C.
       Continua sem moedas/total/nucleo — mercado e placar ficam com o Mestre. */
    function ownPlayerUpdate(v,id,playerId) {
      return signedIn() && active(v,id) && playerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pronto','forma','atualizadoEmMs','pistas','personagem','fragmentoPronto','fragmentoProntoMs','papelCognitivo','camadaAcessibilidade','aliasNarrativo','hpcScaffold','pedidoEnvioFragmento','votoEnvioSim','votoEnvioMs'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pistas']) || (request.resource.data.pistas is list && resource.data.pistas is list && request.resource.data.pistas.size() == resource.data.pistas.size() + 1))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hpcScaffold']) || request.resource.data.hpcScaffold is map)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['personagem']) || request.resource.data.personagem is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['papelCognitivo']) || request.resource.data.papelCognitivo is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['camadaAcessibilidade']) || request.resource.data.camadaAcessibilidade is string);
    }
    function nucleoPortador(v,id) { return resource.data.portadorId == request.auth.uid; }
    function nucleoV3(v,id) { return room(v,id).v3 == true; }
    function membroDoNucleo(v,id) {
      return exists(/databases/$(database)/documents/$(v)/$(id)/jogadores/$(request.auth.uid))
        && get(/databases/$(database)/documents/$(v)/$(id)/jogadores/$(request.auth.uid)).data.nucleo == resource.data.numero;
    }
    function podeEscreverNucleo(v,id) {
      return nucleoPortador(v,id) || nucleoV3(v,id)
        || (resource.data.portadoresCompartilhados == true && membroDoNucleo(v,id));
    }
    /* rascunho: portador (ou mesa ≤3 compartilhada / v3). concluidoEm só
       entra UMA vez, como timestamp do servidor — é o desempate de tempo
       do Mosaico. Playtest: sem isto o envio era recusado e a UI congelava. */
    function validNucleoUpdate(v,id) {
      return signedIn() && active(v,id) && participant(v,id)
        && podeEscreverNucleo(v,id)
        && !resource.data.keys().hasAny(['concluidoEm'])
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rascunho','rascunhoMs'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rascunho','rascunhoMs','concluidoEm'])
            && request.resource.data.concluidoEm is timestamp
          )
        );
    }
    function validTarefa() { return request.resource.data.tarefa in ['inclinacao','janela','vidro','sala','salaescura','escuro','cor','mosaico','encaixe','cooperacao','palimpsesto','espelho','planta','mercado','oleo']; }
    function actorAdvance(v,id) {
      return signedIn() && active(v,id) && participant(v,id)
        && resource.data.fase == 'encenacao'
        && resource.data.ordem is list
        && resource.data.vez is int
        && resource.data.vez >= 0 && resource.data.vez < resource.data.ordem.size()
        && resource.data.ordem[resource.data.vez] == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vez','faseAteMs'])
        && request.resource.data.vez == resource.data.vez + 1;
    }

    match /config/mestres { allow read: if signedIn(); allow write: if false; }
    match /usuarios/{uid}/{document=**} { allow read, write: if signedIn() && request.auth.uid == uid; }

    match /{versao}/{roomId} {
      allow create: if known(versao) && emailMestre() && request.resource.data.mestreUid == request.auth.uid && request.resource.data.ativa == true && request.resource.data.fase == 'sala' && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId)) && (!request.resource.data.keys().hasAny(['ritmo']) || request.resource.data.ritmo in ['automatico','conduzido','calma','pressao']) && (!request.resource.data.keys().hasAny(['formato']) || request.resource.data.formato in ['curta','cheia']);
      allow get: if signedIn() && (!roomExists(versao,roomId) || resource.data.ativa == true || inside(versao,roomId));
      allow list: if false;
      allow update: if (master(versao,roomId) && request.resource.data.mestreUid == resource.data.mestreUid && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId)) && (!request.resource.data.keys().hasAny(['fase']) || faseConhecida(request.resource.data.fase))) || actorAdvance(versao,roomId);
      allow delete: if false;

      match /jogadores/{playerId} {
        allow read: if signedIn() && active(versao,roomId);
        allow create: if signedIn() && active(versao,roomId) && playerId == request.auth.uid && request.resource.data.nome is string && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 60;
        allow update: if active(versao,roomId) && (master(versao,roomId) || ownPlayerUpdate(versao,roomId,playerId));
        allow delete: if false;
      }
      match /publicas/{id} { allow read: if inside(versao,roomId); allow create, update: if master(versao,roomId); allow delete: if false; }
      match /tarefas/{id} {
        allow read: if inside(versao,roomId);
        allow create, update: if active(versao,roomId) && signedIn() && request.resource.data.jogadorId == request.auth.uid && validTarefa();
        allow delete: if false;
      }
      match /nucleos/{id} { allow read: if inside(versao,roomId); allow create: if master(versao,roomId); allow update: if validNucleoUpdate(versao,roomId); allow delete: if false; }
      match /votos/{id} {
        allow read: if master(versao,roomId) || id == request.auth.uid;
        allow create: if active(versao,roomId) && id == request.auth.uid && request.resource.data.de == request.auth.uid && request.resource.data.para != request.auth.uid;
        allow update, delete: if false;
      }
      match /votosCooperacao/{id} { allow read: if inside(versao,roomId); allow create: if active(versao,roomId) && signedIn() && request.resource.data.de == request.auth.uid; allow update, delete: if false; }
      match /acoes/{id} { allow read: if inside(versao,roomId); allow create: if active(versao,roomId) && signedIn() && request.resource.data.jogadorId == request.auth.uid; allow update: if master(versao,roomId); allow delete: if false; }
      match /ofertas/{id} { allow read: if inside(versao,roomId); allow create, update: if active(versao,roomId) && participant(versao,roomId); allow delete: if false; }
      match /negociacoes/{id} { allow read: if inside(versao,roomId); allow create: if active(versao,roomId) && participant(versao,roomId); allow update, delete: if false; }
      match /deducoes/{id} { allow read: if master(versao,roomId) || id == request.auth.uid; allow create: if active(versao,roomId) && id == request.auth.uid && request.resource.data.id == request.auth.uid && (!request.resource.data.keys().hasAny(['partidaId']) || validPartida(request.resource.data.partidaId)); allow update, delete: if false; }
      match /placar/{id} { allow read: if inside(versao,roomId); allow create, update: if master(versao,roomId); allow delete: if false; }
      /* Telemetria de playtest: cada participante cria apenas os próprios eventos;
         só o Mestre pode ler o conjunto da sala. Não concede update/delete. */
      match /eventos/{id} {
        allow read: if master(versao,roomId);
        allow create: if active(versao,roomId) && participant(versao,roomId)
          && request.resource.data.jogadorId == request.auth.uid
          && request.resource.data.tipo is string
          && request.resource.data.ms is int;
        allow update, delete: if false;
      }
      /* O TELÃO NÃO É JOGADOR E NÃO É MESTRE. */
      match /telao/{id} {
        allow read: if signedIn() && active(versao,roomId);
        allow create, update: if signedIn() && active(versao,roomId) && id == request.auth.uid
          && request.resource.data.vistoEmMs is int;
        allow delete: if false;
      }
      match /{otherCollection}/{document=**} { allow read, write: if false; }
    }
  }
}